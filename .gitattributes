# Normalise line endings in the repository, and check out what each platform
# actually needs. Without this, a Windows contributor's CRLF ends up in the
# committed Rust sources, and the PowerShell and batch files that genuinely
# need CRLF get LF.

* text=auto eol=lf

# Windows shells are the exception: cmd.exe mis-parses LF-only batch files,
# and some PowerShell hosts are equally particular.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Windows resource and manifest files.
*.rc    text eol=crlf
*.manifest text eol=crlf

# Binary assets - never touch these.
*.png   binary
*.ico   binary
*.icns  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.msi   binary
*.exe   binary
*.dll   binary
*.pdf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# Generated: keep these out of diffs and language statistics.
Cargo.lock          linguist-generated=true
ui/package-lock.json linguist-generated=true
docs/screenshots/*  linguist-documentation=true
legacy/*            linguist-vendored=true
